# Copy to .env and fill in. Never commit real values.

# Supabase project URL (server / Edge Functions / scripts)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (public) key, safe for read-only demo access under RLS
SUPABASE_ANON_KEY=your-anon-key
# Supabase service role key: server/Edge Functions only, never ship to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vite client-side copies (apps/web); anon key only, never the service role key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Semaphore SMS API key (spec 06 notify)
SEMAPHORE_API_KEY=your-semaphore-api-key
# Semaphore registered sender name
SEMAPHORE_SENDER_NAME=your-sender-name

# Open-Meteo rainfall pull: Catbalogan City, Samar (approx; not secrets)
OPEN_METEO_LAT=11.7753
OPEN_METEO_LON=124.8861
